# sdkconfig parameters for an ESP32 device with PSRAM to put the heap there

# Make almost everything from the application go to PSRAM (FreeRTOS will still allocate from RAM)
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64

# Reserve 128KB of internal RAM for system components (e.g. WiFi, or it may silently fail)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072